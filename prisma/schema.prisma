// Pushlabs Production OS — Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id            String    @id @default(cuid())
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  vatId         String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]
  offers   Offer[]
  invoices Invoice[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  type        String
  status      String        @default("lead")
  shootStart  DateTime?
  shootEnd    DateTime?
  location    String?
  budget      Float?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  offers      Offer[]
  invoices    Invoice[]
  expenses    Expense[]
}

model Offer {
  id            String      @id @default(cuid())
  number        String      @unique
  date          DateTime    @default(now())
  validUntil    DateTime?
  paymentTerms  String?
  notes         String?
  vatRate       Float       @default(19)
  status        String      @default("draft")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])

  items         OfferItem[]
}

model OfferItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  unit        String? @default("Stk.")
  position    Int     @default(0)

  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          DateTime      @default(now())
  dueDate       DateTime?
  paymentTerms  String?
  notes         String?
  vatRate       Float         @default(19)
  status        String        @default("draft")
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])

  items         InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  unit        String? @default("Stk.")
  position    Int     @default(0)

  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String    @id @default(cuid())
  travelDate      DateTime
  startTime       String?
  endTime         String?
  overnight       Boolean   @default(false)
  breakfast       Boolean   @default(false)
  lunch           Boolean   @default(false)
  dinner          Boolean   @default(false)
  people          Int       @default(1)
  allowance       Float     @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id])
}

model CompanySettings {
  id              String    @id @default("singleton")
  companyName     String    @default("Pushlabs")
  owner           String    @default("Daniel Laudowicz")
  address         String?
  taxNumber       String?
  vatId           String?
  email           String?
  phone           String?
  website         String?
  bankName        String?
  iban            String?
  bic             String?
  logoPath        String?
  defaultVatRate  Float     @default(19)
  invoicePrefix   String    @default("RE-001-")
  nextInvoiceNo   Int       @default(26)
  offerPrefix     String    @default("AN-")
  nextOfferNo     Int       @default(1)
  updatedAt       DateTime  @updatedAt
}
